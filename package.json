{
  "name": "fiscalapi-csf",
  "version": "1.0.0",
  "description": "Lector de la Constancia de Situación Fiscal (CSF) del SAT en el navegador: valida el PDF y extrae RFC, nombre, código postal y regímenes vigentes.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:package-json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:package-json": "node scripts/write-dist-package-json.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "fiscalapi",
    "csf",
    "constancia de situación fiscal",
    "sat",
    "rfc",
    "mexico",
    "pdf"
  ],
  "author": "FISCAL API S DE R.L DE C.V",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FiscalAPI/fiscalapi-csf.git"
  },
  "homepage": "https://github.com/FiscalAPI/fiscalapi-csf#readme",
  "bugs": {
    "url": "https://github.com/FiscalAPI/fiscalapi-csf/issues"
  },
  "peerDependencies": {
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "pdfjs-dist": "^6.4.299",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
